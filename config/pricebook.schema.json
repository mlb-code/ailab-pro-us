{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pricebook.schema.json",
  "title": "AI Lab Pro price book",
  "type": "object",
  "required": [
    "version",
    "updated",
    "currency",
    "rules",
    "refund_rules",
    "items",
    "integrations",
    "integration_meta"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "currency": {
      "enum": [
        "USD"
      ]
    },
    "rules": {
      "type": "object",
      "required": [
        "core_codes",
        "deposit_pct",
        "rush_pct",
        "manual_price_setup_over_cents",
        "quote_valid_days",
        "discounts",
        "included_usage",
        "overage_markup_pct",
        "custom_triggers",
        "liability_cap_months",
        "liability_cap_floor_usd",
        "plan_b_enabled"
      ],
      "properties": {
        "core_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "one_core_offer_per_quote": {
          "type": "boolean"
        },
        "deposit_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "deposit_rounding": {
          "enum": [
            "whole_dollars"
          ]
        },
        "rush_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "manual_price_setup_over_cents": {
          "type": "integer",
          "minimum": 0
        },
        "quote_valid_days": {
          "type": "integer",
          "minimum": 1
        },
        "discounts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "setup_pct",
              "monthly_pct",
              "applied_by"
            ],
            "properties": {
              "setup_pct": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "monthly_pct": {
                "type": "integer",
                "minimum": 0,
                "maximum": 0
              },
              "max_clients": {
                "type": "integer",
                "minimum": 1
              },
              "applied_by": {
                "enum": [
                  "admin"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "monthly_discounts_allowed": {
          "const": false
        },
        "monthly_billing": {
          "type": "string"
        },
        "cancel_notice_days": {
          "type": "integer",
          "minimum": 0
        },
        "liability_cap_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24,
          "description": "Liability cap: fees paid in the N months before the event (Terms §15, SA §15). Legal pages stamp it."
        },
        "liability_cap_floor_usd": {
          "type": "integer",
          "minimum": 0,
          "description": "Liability cap floor in whole US dollars: the cap is the greater of N months of fees or this amount."
        },
        "included_usage": {
          "type": "object",
          "required": [
            "voice_minutes",
            "sms_segments"
          ],
          "properties": {
            "voice_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "sms_segments": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "overage_markup_pct": {
          "type": "integer",
          "minimum": 0
        },
        "custom_triggers": {
          "type": "object"
        },
        "upwork_same_prices": {
          "type": "boolean"
        },
        "upwork_plans": {
          "type": "array",
          "items": {
            "enum": [
              "A"
            ]
          },
          "minItems": 1,
          "description": "Upwork sells plan A only (setup + monthly, or the annual prepay)."
        },
        "annual_prepay": {
          "type": "object",
          "required": [
            "months_paid",
            "months_covered",
            "plan",
            "channels",
            "label"
          ],
          "properties": {
            "months_paid": {
              "type": "integer",
              "minimum": 1
            },
            "months_covered": {
              "type": "integer",
              "minimum": 1
            },
            "with_setup": {
              "type": "boolean"
            },
            "plan": {
              "enum": [
                "A"
              ]
            },
            "channels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string"
            }
          }
        },
        "availability": {
          "type": "object",
          "required": [
            "coming_soon_label",
            "coming_soon_text",
            "reasons"
          ],
          "properties": {
            "coming_soon_label": {
              "type": "string",
              "minLength": 1
            },
            "coming_soon_text": {
              "type": "string",
              "minLength": 1
            },
            "reasons": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "plan_b_enabled": {
          "type": "boolean",
          "description": "Plan B (no setup fee, 12-month minimum). false = never shown on the site or offered in quotes; the public site copy drops term_plan and plan_b_monthly_cents."
        },
        "term_plan": {
          "type": "object",
          "required": [
            "setup_cents",
            "min_months",
            "premium_pct",
            "first_charge",
            "after_term",
            "early_exit",
            "founding_applies",
            "channels"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "setup_cents": {
              "const": 0
            },
            "min_months": {
              "type": "integer",
              "minimum": 1
            },
            "premium_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "formula": {
              "type": "string"
            },
            "first_charge": {
              "enum": [
                "at_signing",
                "at_go_live"
              ]
            },
            "first_charge_refund": {
              "enum": [
                "deposit_rule"
              ]
            },
            "after_term": {
              "enum": [
                "monthly_a"
              ]
            },
            "cancel_notice_days_after_term": {
              "type": "integer",
              "minimum": 0
            },
            "early_exit": {
              "enum": [
                "setup_remaining_share"
              ]
            },
            "early_exit_text": {
              "type": "string"
            },
            "guarantee_exit": {
              "enum": [
                "no_balance"
              ]
            },
            "founding_applies": {
              "const": false
            },
            "card_on_file": {
              "type": "boolean"
            },
            "channels": {
              "type": "array",
              "items": {
                "enum": [
                  "site"
                ]
              }
            },
            "eligible": {
              "type": "string"
            }
          }
        }
      }
    },
    "refund_rules": {
      "type": "object",
      "required": [
        "deposit",
        "retainer",
        "rcp_guarantee_days",
        "rcp_guarantee"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "deposit": {
          "type": "object",
          "required": [
            "refund_pct",
            "window_days",
            "text"
          ],
          "properties": {
            "refund_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "window_days": {
              "type": "integer",
              "minimum": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "retainer": {
          "type": "object",
          "required": [
            "refund_pct",
            "window_days",
            "text"
          ],
          "properties": {
            "refund_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "window_days": {
              "type": "integer",
              "minimum": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "rcp_guarantee_days": {
          "type": "integer",
          "minimum": 1
        },
        "rcp_guarantee": {
          "type": "object",
          "required": [
            "codes",
            "window_from",
            "refunds",
            "monthly_fees_refunded",
            "label",
            "text",
            "legal"
          ],
          "properties": {
            "codes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "RCP",
                  "BNDL"
                ]
              }
            },
            "window_from": {
              "enum": [
                "go_live"
              ]
            },
            "refunds": {
              "enum": [
                "setup_fee"
              ]
            },
            "bundle_refunds": {
              "enum": [
                "rcp_setup_part"
              ]
            },
            "monthly_fees_refunded": {
              "const": false
            },
            "service_after_refund": {
              "enum": [
                "switched_off"
              ]
            },
            "not_for": {
              "type": "string"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "legal": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "integrations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(native|zapier|custom|addon:[A-Z][A-Z0-9-]*)$"
      }
    },
    "integration_meta": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "category",
          "niches"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "niches": {
            "type": "array",
            "items": {
              "enum": [
                "*",
                "home_services",
                "real_estate"
              ]
            },
            "minItems": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "cents": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "item": {
      "type": "object",
      "required": [
        "code",
        "name",
        "group",
        "kind",
        "setup_cents",
        "monthly_cents",
        "applies_to",
        "includes",
        "excludes"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "enum": [
            "core",
            "addon",
            "later"
          ]
        },
        "kind": {
          "enum": [
            "fixed",
            "from",
            "custom",
            "percent"
          ]
        },
        "setup_cents": {
          "$ref": "#/$defs/cents"
        },
        "monthly_cents": {
          "$ref": "#/$defs/cents"
        },
        "plan_b_monthly_cents": {
          "$ref": "#/$defs/cents",
          "description": "Plan B monthly (no setup fee, first 12 months); see rules.term_plan."
        },
        "setup_pct": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "pct_of": {
          "enum": [
            "setup_subtotal_before_rush"
          ]
        },
        "applies_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "availability": {
          "enum": [
            "available",
            "coming_soon"
          ],
          "description": "coming_soon = listed with a \"Coming soon\" label, never quotable or purchasable (pricing.mjs rejects it)."
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Why it is not available yet: keys of rules.availability.reasons."
        },
        "delivery_business_days": {
          "type": "integer",
          "minimum": 1
        },
        "delivery_starts": {
          "type": "string"
        },
        "marketed": {
          "type": "boolean"
        },
        "direct_checkout": {
          "type": "boolean"
        },
        "contains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "per": {
          "type": "string"
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
