# Copy to .secrets.env (gitignored) and paste each value after the = sign. Never commit the real file.
# Read only by tools/us_setup.py and tools/us_setup_check.py; values are never printed.
SUPABASE_ACCESS_TOKEN=
# Optional: organization slug, needed only if the Supabase account has more than one organization
SUPABASE_ORG_SLUG=
RESEND_API_KEY=
ANTHROPIC_API_KEY=
# Google sign-in for the client portal
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ZAPIER_SIGNING_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Card / PayPal checkout: developer.paypal.com -> Apps & Credentials -> app "AI Lab Pro checkout" (Sandbox and Live).
# Used only by: python3 tools/us_setup.py --only paypal --paypal-env sandbox|live (never printed, never in git).
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
# Written by tools/us_setup.py --create (strong random DB password). Do not edit.
# SUPABASE_DB_PASSWORD=
# Written by tools/us_setup.py --only supabase-keys: a named Supabase SECRET key (sb_secret_..., not the legacy service_role JWT).
# The same value goes to: Edge Function secret SB_SERVICE_KEY, Vault ailab_us_service_role_key (--only vault,secrets),
# Railway SUPABASE_SERVICE_ROLE_KEY and the GitHub secret US_SUPABASE_SERVICE_KEY (by hand / gh secret set). Do not edit.
# SUPABASE_SECRET_KEY=
